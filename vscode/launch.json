{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Player 1 (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4317",
      "webRoot": "${workspaceFolder}/public",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-player-1"
    },
    {
      "name": "Player 2 (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4317",
      "webRoot": "${workspaceFolder}/public",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-player-2"
    },
    {
      "name": "Player 1 (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:4317",
      "webRoot": "${workspaceFolder}/public",
      "userDataDir": "${workspaceFolder}/.vscode/edge-player-1"
    },
    {
      "name": "Server tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["--test", "${workspaceFolder}/tests/server.test.js"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Server + 2 players",
      "configurations": ["Server", "Player 1 (Chrome)", "Player 2 (Chrome)"],
      "stopAll": true
    }
  ]
}
